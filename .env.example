# ─── Server ────────────────────────────────────────────────
PORT=5000

# ─── MongoDB ───────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cropiq

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ─── AI Services ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
WOLFRAM_APP_ID=your_wolfram_app_id_here

# ─── ArmorIQ Security SDK ──────────────────────────────────
# Generate your key at https://platform.armoriq.ai
# Key name used: cropiq-backend-dev
# Place the REAL key value in .env (which is gitignored) — NEVER here.
ARMORIQ_API_KEY=your_armoriq_api_key_here
